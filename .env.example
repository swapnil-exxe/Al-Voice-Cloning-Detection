# VOICEGUARD Environment Configurations

# Database Settings
# For local fallback to SQLite, leave DATABASE_URL empty or comment it out.
# For production PostgreSQL/Supabase, provide the full connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/voiceguard
# DATABASE_URL=sqlite:///./voiceguard.db

# Authentication Security
JWT_SECRET=supersecretjwtkeyforvoiceguardprototype2026sih
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Configuration
MODEL_PATH=ml/models/saved_models/voiceguard_v1.0.pt
MODEL_VERSION=voiceguard-v1.0

# Server Connections
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional Telephony Integration (Twilio Adapter)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
